# =====================================================================
# Shared ignore rules
# =====================================================================
# Operating system and editor files
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/

# Local secrets and credentials
.env
.env.*
!.env.example
*.pem
*.key
*.p12
kubeconfig
kubeconfig*
*.kubeconfig
credentials
credentials.json

# =====================================================================
# gitops-config
# =====================================================================
# Unencrypted secret manifests
*.unsealed.yaml
*.plain.yaml
secrets/
# Uncomment to track the public Sealed Secrets certificate.
# !sealed-secrets-cert.pem

# Helm charts fetched by Kustomize
charts/
# Locally rendered manifests
rendered/
