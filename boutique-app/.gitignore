# =====================================================================
# Shared ignore rules
# =====================================================================
# Operating system and editor files
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/

# Local secrets and credentials
.env
.env.*
!.env.example
*.pem
*.key
*.p12
kubeconfig
kubeconfig*
*.kubeconfig
credentials
credentials.json

# =====================================================================
# boutique-app (Go, C#, Node.js, Python, Java)
# =====================================================================
# Go
*.test
*.out
vendor/

# Node.js
node_modules/
npm-debug.log*

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Java (Gradle)
.gradle/
build/
target/

# C# (.NET)
bin/
obj/

# Local scan results
trivy-*.json
sbom*.json
