# Export this configuration before running a live report.
OPENCOST_URL=http://localhost:9003

# Leave ATHENA_TABLE empty to report Kubernetes allocations only.
AWS_REGION=
ATHENA_DATABASE=
ATHENA_TABLE=
ATHENA_WORKGROUP=primary
ATHENA_OUTPUT_S3=

# Leave NOTIFIER empty to print only, or choose slack or telegram.
NOTIFIER=
NOTIFY_FAILURES=false
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# USD rates. Empty values use illustrative US East defaults (730 hours/month).
EBS_GB_MONTH_RATE=
SNAPSHOT_GB_MONTH_RATE=
EIP_HOURLY_RATE=
ALB_HOURLY_RATE=
