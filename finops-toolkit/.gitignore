# =====================================================================
# Shared ignore rules
# =====================================================================
# Operating system and editor files
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/

# Local secrets and credentials
.env
.env.*
!.env.example
*.pem
*.key
*.p12
kubeconfig
kubeconfig*
*.kubeconfig
credentials
credentials.json

# =====================================================================
# finops-toolkit (Python)
# =====================================================================
# Python
__pycache__/
*.py[cod]
.venv/
dist/
build/
*.egg-info/

# Lint and test caches
.ruff_cache/
.mypy_cache/
.pytest_cache/
.coverage
htmlcov/

# Cloud Custodian output
output/
# Local reports
reports/
